# URL pública do site (usada nos QR codes, emails e passes)
NEXT_PUBLIC_SITE_URL=https://campsummit.pt

# --- Email com o bilhete (Resend: https://resend.com) ---
# Sem isto, o bilhete é gerado na mesma, mas não é enviado email.
RESEND_API_KEY=
EMAIL_FROM="Camp Summit <bilhetes@campsummit.pt>"

# --- Apple Wallet (.pkpass) ---
# Precisa de conta Apple Developer + Pass Type ID. PEMs em texto (com \n) ou em base64.
APPLE_PASS_TYPE_ID=pass.pt.campsummit.ticket
APPLE_TEAM_ID=
APPLE_WWDR_PEM=
APPLE_SIGNER_CERT_PEM=
APPLE_SIGNER_KEY_PEM=
APPLE_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet ---
# Conta de serviço com acesso ao Google Wallet API + Issuer ID.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
